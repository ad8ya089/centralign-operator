NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Relative paths resolve from the repository root. Absolute paths also work.
DATABASE_PATH=.data/centralign.sqlite
ARTIFACT_WORKSPACE_PATH=.data/workspaces
# Comma-separated exact HTTP(S) origins. Empty means browser navigation is denied.
BROWSER_ALLOWED_ORIGINS=
# Credentials are optional at startup and required only for the selected live provider.
# Unpaid Gemini content may be used for product improvement and human review.
# Use fictional or explicitly approved test data; never send confidential records.
MODEL_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=replace-with-your-key
MODEL_TIMEOUT_MS=30000
# Optional alternative: set MODEL_PROVIDER=openai and configure this key.
# OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-6-sol
# Legacy timeout fallback when MODEL_TIMEOUT_MS is unset.
OPENAI_TIMEOUT_MS=30000
AGENT_MAX_MODEL_CALLS=40
AGENT_MAX_TOOL_CALLS=60
AGENT_MAX_RECOVERY_ATTEMPTS=2
AGENT_MAX_REPLANS=4
AGENT_RUN_TIMEOUT_MS=1800000
