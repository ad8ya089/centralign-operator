{
  "name": "@centralign/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --include ../../packages/shared/dist/**/*.js src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "agent:demo": "tsx src/cli/agent-demo.ts",
    "model:smoke": "tsx src/cli/model-smoke.ts",
    "agent:evaluate": "tsx src/cli/agent-evaluate.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@centralign/shared": "0.1.0",
    "@google/genai": "2.31.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "openai": "7.43.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "tsx": "4.23.15"
  }
}
